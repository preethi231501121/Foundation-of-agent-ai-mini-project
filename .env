APP_NAME=AcademicPilot AI
ENVIRONMENT=development
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./data/academicpilot.db
FRONTEND_ORIGIN=http://localhost:5173

# demo | openai_compatible
LLM_PROVIDER=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

# hash is local/offline. You can replace this service with another embedding provider.
EMBEDDING_PROVIDER=hash
CHROMA_PATH=./data/chroma
RESOURCE_STORAGE_PATH=./data/resources
MASTERY_WEIGHTS={"accuracy":0.45,"recent":0.25,"assessment":0.20,"completion":0.10}
MASTERY_THRESHOLDS={"weak":40,"developing":60,"good":80,"mastered":85}
